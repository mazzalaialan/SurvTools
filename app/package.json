{
  "name": "vikarg-survival",
  "private": true,
  "version": "0.112.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "licenses": "node scripts/third-party-licenses.mjs",
    "data-sizes": "node scripts/data-sizes.mjs",
    "e2e": "playwright test",
    "e2e:full": "sh scripts/e2e-full.sh",
    "e2e:rapido": "playwright test --project=desktop --grep-invert \"mapa|seguir un track\"",
    "icons": "node scripts/generate-icons.mjs",
    "android:debug": "npm run icons:android && npm run build && cap sync android && node scripts/prune-native-data.mjs && cd android && ./gradlew --no-daemon assembleDebug",
    "icons:android": "node scripts/generate-android-icons.mjs",
    "icons:android:release": "node scripts/generate-android-icons.mjs --release",
    "splash:android": "node scripts/generate-android-splash.mjs",
    "android:debug:escuela": "ALLOW_BACKUP=true VITE_COMMERCIAL=1 npm run android:debug",
    "assets:ios": "node scripts/generate-ios-assets.mjs"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "8.0.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capgo/background-geolocation": "8.6.4",
    "@capgo/capacitor-barometer": "8.0.25",
    "@capgo/capacitor-compass": "8.1.26",
    "@capgo/capacitor-native-biometric": "8.9.3",
    "@neaps/tide-predictor": "0.11.0",
    "astronomy-engine": "2.1.19",
    "dexie": "^4.4.7",
    "fflate": "^0.8.3",
    "i18next": "^26.5.12",
    "lucide-react": "^1.65.0",
    "magvar": "2.2.0",
    "maplibre-contour": "0.1.1",
    "maplibre-gl": "6.14.0",
    "pmtiles": "4.5.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "uuid": "^14.0.3",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
